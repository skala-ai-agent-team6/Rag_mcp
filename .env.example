# Copy to .env in the project root. Existing environment variables take precedence.
OPENAI_API_KEY=
OPENAI_OBSERVATION_MODEL=gpt-4.1-mini
# Optional absolute paths; defaults are this project's data/ and .runtime/.
# REPAIR_DATA_DIR=/absolute/path/to/data
# REPAIR_RUNTIME_DIR=/absolute/path/to/.runtime
REPAIR_EMBED_MODEL=intfloat/multilingual-e5-small
REPAIR_EMBED_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
# Set a Qdrant server URL for Docker/team deployment; unset for single-process local mode.
# QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=
